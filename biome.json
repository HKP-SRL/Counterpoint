{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.tmp",
      "!**/tests/fixtures",
      "!**/.claude",
      "!docs",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/compose.ts", "!src/adapters/openspec/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/adapters/openspec", "**/adapters/openspec/**"],
                    "message": "only src/compose.ts may import the OpenSpec adapter"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/adapters", "**/adapters/**", "#adapters/**"],
                    "message": "core must not import adapters"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
